@model AirlineTicketingSystem.Models.ViewModels.LoginVM

@{
    ViewData["Title"] = "Login";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login — AeroNexa</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800&family=Space+Grotesk:wght@700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body {
            font-family: 'Inter', sans-serif;
            background: #0a0f1e;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2rem;
            position: relative;
            overflow: hidden;
        }
        /* Gradient orbs */
        body::before {
            content: '';
            position: fixed;
            width: 600px; height: 600px;
            background: radial-gradient(circle, rgba(26,115,232,0.12), transparent 70%);
            top: -200px; left: -200px;
            border-radius: 50%;
        }
        body::after {
            content: '';
            position: fixed;
            width: 500px; height: 500px;
            background: radial-gradient(circle, rgba(0,198,255,0.08), transparent 70%);
            bottom: -150px; right: -150px;
            border-radius: 50%;
        }
        .auth-container {
            position: relative;
            z-index: 1;
            width: 100%;
            max-width: 440px;
        }
        .auth-card {
            background: rgba(255,255,255,0.04);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 24px;
            padding: 2.5rem;
            backdrop-filter: blur(20px);
            box-shadow: 0 24px 80px rgba(0,0,0,0.4);
        }
        .logo-text {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 800;
            font-size: 1.75rem;
            background: linear-gradient(135deg, #fff, #a5c8ff, #00c6ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }
        .form-control {
            background: rgba(255,255,255,0.06) !important;
            border: 1px solid rgba(255,255,255,0.12) !important;
            border-radius: 12px !important;
            color: #e2e8f0 !important;
            padding: 0.8rem 1rem;
            font-size: 0.9rem;
            transition: all 0.2s;
        }
        .form-control::placeholder { color: rgba(226,232,240,0.35); }
        .form-control:focus {
            background: rgba(255,255,255,0.09) !important;
            border-color: #1a73e8 !important;
            box-shadow: 0 0 0 3px rgba(26,115,232,0.2) !important;
            color: #fff !important;
        }
        .input-group-text {
            background: rgba(255,255,255,0.06) !important;
            border: 1px solid rgba(255,255,255,0.12) !important;
            color: rgba(226,232,240,0.5) !important;
            border-radius: 12px 0 0 12px !important;
        }
        .input-group .form-control { border-radius: 0 12px 12px 0 !important; }
        .input-group .btn-outline-secondary {
            background: rgba(255,255,255,0.06) !important;
            border: 1px solid rgba(255,255,255,0.12) !important;
            border-left: none !important;
            color: rgba(226,232,240,0.5) !important;
            border-radius: 0 12px 12px 0 !important;
            transition: all 0.2s;
        }
        .input-group .btn-outline-secondary:hover { background: rgba(255,255,255,0.12) !important; color: #fff !important; }
        .form-label { color: rgba(226,232,240,0.7); font-size: 0.85rem; font-weight: 500; margin-bottom: 0.4rem; }
        .btn-login {
            background: linear-gradient(135deg, #1a73e8, #00c6ff);
            border: none;
            border-radius: 100px;
            color: #fff;
            font-weight: 700;
            font-size: 0.95rem;
            padding: 0.875rem;
            width: 100%;
            cursor: pointer;
            box-shadow: 0 8px 24px rgba(26,115,232,0.4);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
        }
        .btn-login:hover { transform: translateY(-2px); box-shadow: 0 12px 32px rgba(26,115,232,0.55); }
        .divider { border: none; border-top: 1px solid rgba(255,255,255,0.08); margin: 1.5rem 0; }
        .link-accent { color: #00c6ff; text-decoration: none; font-weight: 600; transition: color 0.2s; }
        .link-accent:hover { color: #1a73e8; }
        .text-muted-light { color: rgba(165,200,255,0.5); font-size: 0.85rem; }
        .alert { border-radius: 12px; font-size: 0.85rem; }
        .alert-danger { background: rgba(239,68,68,0.1); border: 1px solid rgba(239,68,68,0.2); color: #f87171; }
        .back-link { color: rgba(165,200,255,0.5); text-decoration: none; font-size: 0.85rem; transition: color 0.2s; }
        .back-link:hover { color: #00c6ff; }
        .form-check-input {
            background-color: rgba(255,255,255,0.06);
            border-color: rgba(255,255,255,0.2);
        }
        .form-check-input:checked { background-color: #1a73e8; border-color: #1a73e8; }
        .form-check-label { color: rgba(226,232,240,0.6); font-size: 0.85rem; }
    </style>
</head>
<body>
    <div class="auth-container">
        <!-- Back link -->
        <div class="text-center mb-4">
            <a href="/" class="back-link"><i class="bi bi-arrow-left me-1"></i>Back to AeroNexa</a>
        </div>

        <div class="auth-card">
            <!-- Logo -->
            <div class="text-center mb-4">
                <div class="mb-2" style="font-size:2rem;">✈️</div>
                <div class="logo-text">AeroNexa</div>
                <p class="text-muted-light mt-1">Welcome back! Sign in to continue.</p>
            </div>

            <!-- Error message -->
            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-danger mb-3">
                    <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
                </div>
            }

            <form asp-action="Login" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3" style="display:none;"></div>

                <div class="mb-3">
                    <label asp-for="UserName" class="form-label">Username</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-person"></i></span>
                        <input asp-for="UserName" class="form-control" placeholder="Enter your username" autocomplete="username" />
                    </div>
                    <span asp-validation-for="UserName" class="text-danger" style="font-size:0.8rem;"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="Password" class="form-label">Password</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-lock"></i></span>
                        <input asp-for="Password" type="password" class="form-control" id="passwordInput" placeholder="Enter your password" autocomplete="current-password" />
                        <button class="btn btn-outline-secondary" type="button" onclick="togglePassword()">
                            <i class="bi bi-eye-slash" id="toggleIcon"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Password" class="text-danger" style="font-size:0.8rem;"></span>
                </div>

                <div class="d-flex justify-content-between align-items-center mb-4">
                    <div class="form-check mb-0">
                        <input type="checkbox" class="form-check-input" id="rememberMe">
                        <label class="form-check-label" for="rememberMe">Remember me</label>
                    </div>
                    <a href="#" class="link-accent" style="font-size:0.85rem;">Forgot Password?</a>
                </div>

                <button type="submit" class="btn-login">
                    <i class="bi bi-box-arrow-in-right me-2"></i>Sign In
                </button>
            </form>

            <hr class="divider">

            <div class="text-center">
                <span class="text-muted-light">Don't have an account? </span>
                <a asp-action="Register" class="link-accent">Create one for free</a>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
    <script>
        // Show validation summary if errors
        const valSummary = document.querySelector('[data-valmsg-summary]');
        if (valSummary && valSummary.querySelector('li')) {
            valSummary.closest('.alert').style.display = 'block';
        }

        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const icon = document.getElementById('toggleIcon');
            if (input.type === 'password') {
                input.type = 'text';
                icon.classList.replace('bi-eye-slash', 'bi-eye');
            } else {
                input.type = 'password';
                icon.classList.replace('bi-eye', 'bi-eye-slash');
            }
        }
    </script>
</body>
</html>
