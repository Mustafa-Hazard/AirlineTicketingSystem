@model IEnumerable<AirlineTicketingSystem.Models.Entities.Flight>

@{
    ViewData["Title"] = "All Flights";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <div>
        <div class="section-title mb-1">
            <i class="bi bi-airplane text-primary"></i>
            @(User.IsInRole("Admin") ? "Flight Management" : "Available Flights")
        </div>
        <p class="mb-0" style="color:rgba(165,200,255,0.55);font-size:0.875rem;">
            @if (User.IsInRole("Admin")) { <text>Manage all flights — add, edit, delay, or remove routes.</text> }
            else { <text>Browse all available flights and find your next journey.</text> }
        </p>
    </div>
    @if (User.IsInRole("Admin"))
    {
        <a asp-action="Create" class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add Flight</a>
    }
</div>

@{
    var activeFlights = Model.Where(f => !f.IsCancelled).ToList();
    var cancelledFlights = Model.Where(f => f.IsCancelled).ToList();
}

@if (!Model.Any())
{
    <div class="text-center py-5 glass-panel">
        <i class="bi bi-airplane" style="font-size:4rem;color:rgba(165,200,255,0.2);"></i>
        <h5 class="mt-3" style="color:rgba(165,200,255,0.5);">No flights available</h5>
        @if (User.IsInRole("Admin"))
        {
            <a asp-action="Create" class="btn btn-primary mt-3"><i class="bi bi-plus"></i> Add First Flight</a>
        }
    </div>
}
else
{
    <div class="card">
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover mb-0">
                    <thead>
                        <tr>
                            <th><i class="bi bi-hash me-1"></i>Flight</th>
                            <th><i class="bi bi-map me-1"></i>Route</th>
                            <th><i class="bi bi-clock me-1"></i>Departure</th>
                            <th><i class="bi bi-clock-history me-1"></i>Arrival</th>
                            <th>Economy</th>
                            <th>Business</th>
                            <th>First Class</th>
                            <th><i class="bi bi-three-dots me-1"></i>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var f in Model)
                        {
                            <tr style="@(f.IsCancelled ? "opacity:0.5;" : "")">
                                <td>
                                    <div class="d-flex align-items-center gap-2">
                                        <div style="width:36px;height:36px;border-radius:8px;background:linear-gradient(135deg,#1a73e8,#00c6ff);display:flex;align-items:center;justify-content:center;flex-shrink:0;">
                                            <i class="bi bi-airplane-fill" style="color:#fff;font-size:0.85rem;"></i>
                                        </div>
                                        <div>
                                            <div style="font-weight:700;color:#fff;font-family:'Space Grotesk',sans-serif;">@f.FlightNumber</div>
                                            @if (f.IsDelayed) { <span class="badge bg-warning" style="font-size:0.65rem;">Delayed</span> }
                                            @if (f.IsCancelled) { <span class="badge bg-danger" style="font-size:0.65rem;">Cancelled</span> }
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <div class="d-flex align-items-center gap-1" style="font-weight:600;">
                                        <span style="color:#fff;">@f.Origin</span>
                                        <i class="bi bi-arrow-right" style="color:rgba(165,200,255,0.4);font-size:0.75rem;"></i>
                                        <span style="color:#fff;">@f.Destination</span>
                                    </div>
                                    @if (!string.IsNullOrEmpty(f.FromAirport) && !string.IsNullOrEmpty(f.ToAirport))
                                    {
                                        <div style="font-size:0.7rem;color:rgba(165,200,255,0.4);">@f.FromAirport → @f.ToAirport</div>
                                    }
                                </td>
                                <td>
                                    <div style="color:#e2e8f0;">@f.DepartureTime.ToString("MMM dd")</div>
                                    <div style="font-size:0.8rem;color:rgba(165,200,255,0.5);">@f.DepartureTime.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div style="color:#e2e8f0;">@f.ArrivalTime.ToString("MMM dd")</div>
                                    <div style="font-size:0.8rem;color:rgba(165,200,255,0.5);">@f.ArrivalTime.ToString("HH:mm")</div>
                                </td>
                                <td>
                                    <div style="color:#00d4aa;font-weight:700;">@f.EconomyPrice.ToString("C0")</div>
                                    <div style="font-size:0.75rem;color:rgba(165,200,255,0.4);">@f.AvailableEconomySeats / @f.EconomySeats seats</div>
                                </td>
                                <td>
                                    <div style="color:#f5a623;font-weight:700;">@f.BusinessPrice.ToString("C0")</div>
                                    <div style="font-size:0.75rem;color:rgba(165,200,255,0.4);">@f.AvailableBusinessSeats / @f.BusinessSeats seats</div>
                                </td>
                                <td>
                                    <div style="color:#a855f7;font-weight:700;">@f.FirstClassPrice.ToString("C0")</div>
                                    <div style="font-size:0.75rem;color:rgba(165,200,255,0.4);">@f.AvailableFirstClassSeats / @f.FirstClassSeats seats</div>
                                </td>
                                <td>
                                    <div class="d-flex flex-wrap gap-1">
                                        <a asp-action="Details" asp-route-id="@f.Id" class="btn btn-sm btn-info">
                                            <i class="bi bi-info-circle"></i>
                                        </a>
                                        @if (User.IsInRole("Admin"))
                                        {
                                            <a asp-action="Edit" asp-route-id="@f.Id" class="btn btn-sm btn-warning"><i class="bi bi-pencil"></i></a>
                                            <a asp-action="Delay" asp-route-id="@f.Id" class="btn btn-sm btn-secondary"><i class="bi bi-clock"></i></a>
                                            <a asp-action="Delete" asp-route-id="@f.Id" class="btn btn-sm btn-danger"><i class="bi bi-trash"></i></a>
                                        }
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Summary bar -->
    <div class="d-flex gap-4 mt-3" style="font-size:0.8rem;color:rgba(165,200,255,0.5);">
        <span><i class="bi bi-airplane me-1"></i>@activeFlights.Count active</span>
        @if (cancelledFlights.Any()) { <span><i class="bi bi-x-circle me-1"></i>@cancelledFlights.Count cancelled</span> }
        <span><i class="bi bi-list me-1"></i>@Model.Count() total</span>
    </div>
}
