@{
    ViewData["Title"] = "Home";
}

<!-- Hero Section -->
<div class="position-relative mb-5" style="border-radius:24px;overflow:hidden;min-height:380px;background:linear-gradient(135deg,#0d1b3e 0%,#1a3a6b 50%,#0a0f1e 100%);">
    <div style="position:absolute;top:0;right:0;width:60%;height:100%;opacity:0.07;background:url('https://images.unsplash.com/photo-1436491865332-7a61a109cc05?auto=format&fit=crop&w=1200&q=80') center/cover;"></div>
    <div style="position:absolute;top:-80px;right:-80px;width:400px;height:400px;background:radial-gradient(circle,rgba(26,115,232,0.15),transparent 70%);border-radius:50%;"></div>

    <div class="position-relative d-flex align-items-center h-100 p-5" style="min-height:380px;z-index:1;">
        <div class="col-lg-7">
            <div class="mb-3" style="display:inline-flex;align-items:center;gap:0.5rem;background:rgba(26,115,232,0.15);border:1px solid rgba(26,115,232,0.3);border-radius:100px;padding:0.4rem 1rem;font-size:0.8rem;color:#a5c8ff;">
                <span class="pulse-dot"></span> Live Flight Status Available
            </div>
            <h1 style="font-family:'Space Grotesk',sans-serif;font-weight:900;font-size:clamp(2.2rem,5vw,3.5rem);color:#fff;line-height:1.1;margin-bottom:1rem;">
                Your Sky,<br>
                <span style="background:linear-gradient(90deg,#1a73e8,#00c6ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;">Your Journey</span>
            </h1>
            <p style="color:rgba(165,200,255,0.75);font-size:1.05rem;max-width:480px;margin-bottom:2rem;line-height:1.7;">
                Discover seamless travel with AeroNexa. Search flights, book tickets, and manage your journey all in one place.
            </p>
            <div class="d-flex flex-wrap gap-3">
                <a asp-controller="Flights" asp-action="Search" class="btn btn-primary btn-lg">
                    <i class="bi bi-search"></i> Search Flights
                </a>
                @if (!User.Identity.IsAuthenticated)
                {
                    <a asp-controller="Auth" asp-action="Register" class="btn btn-secondary btn-lg">
                        <i class="bi bi-person-plus"></i> Join Free
                    </a>
                }
                else
                {
                    <a asp-controller="Booking" asp-action="Create" class="btn btn-secondary btn-lg">
                        <i class="bi bi-ticket-perforated"></i> Book Now
                    </a>
                }
            </div>
        </div>

        <div class="d-none d-lg-block position-absolute" style="right:2rem;top:50%;transform:translateY(-50%);">
            <div class="glass-panel p-4" style="width:280px;">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span style="font-size:0.7rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(165,200,255,0.5);">Popular Route</span>
                    <span class="badge bg-success" style="font-size:0.65rem;">Available</span>
                </div>
                <div class="d-flex align-items-center justify-content-between mb-3">
                    <div>
                        <div style="font-family:'Space Grotesk',sans-serif;font-size:1.75rem;font-weight:800;color:#fff;">KHI</div>
                        <div style="font-size:0.7rem;color:rgba(165,200,255,0.5);">Karachi</div>
                    </div>
                    <div class="text-center flex-grow-1 px-2">
                        <i class="bi bi-airplane-fill" style="color:#1a73e8;font-size:1.2rem;"></i>
                        <div style="height:1px;background:linear-gradient(90deg,rgba(26,115,232,0.3),#1a73e8,rgba(26,115,232,0.3));margin:6px 0;"></div>
                        <div style="font-size:0.65rem;color:rgba(165,200,255,0.4);">~2h 30m</div>
                    </div>
                    <div class="text-end">
                        <div style="font-family:'Space Grotesk',sans-serif;font-size:1.75rem;font-weight:800;color:#fff;">ISB</div>
                        <div style="font-size:0.7rem;color:rgba(165,200,255,0.5);">Islamabad</div>
                    </div>
                </div>
                <div style="background:rgba(26,115,232,0.1);border:1px solid rgba(26,115,232,0.2);border-radius:12px;padding:0.75rem;text-align:center;">
                    <div style="font-size:0.65rem;color:rgba(165,200,255,0.5);text-transform:uppercase;letter-spacing:0.08em;">From</div>
                    <div style="font-family:'Space Grotesk',sans-serif;font-size:1.4rem;font-weight:800;color:#00c6ff;">PKR 8,500</div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Quick Search -->
<div class="glass-panel p-4 mb-5">
    <div class="section-title"><i class="bi bi-funnel-fill text-primary"></i>Quick Search</div>
    <form method="get" asp-controller="Flights" asp-action="Search">
        <div class="row g-3">
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-geo-alt me-1"></i>From</label>
                <input type="text" class="form-control" name="Origin" placeholder="e.g. Karachi, KHI">
            </div>
            <div class="col-md-4">
                <label class="form-label"><i class="bi bi-geo me-1"></i>To</label>
                <input type="text" class="form-control" name="Destination" placeholder="e.g. Dubai, DXB">
            </div>
            <div class="col-md-2">
                <label class="form-label"><i class="bi bi-calendar me-1"></i>Date</label>
                <input type="date" class="form-control" name="DepartureDate">
            </div>
            <div class="col-md-2 d-flex align-items-end">
                <button type="submit" class="btn btn-primary w-100"><i class="bi bi-search"></i> Search</button>
            </div>
        </div>
    </form>
</div>

@if (User.IsInRole("Admin"))
{
    <div class="alert alert-info mb-4 d-flex align-items-center gap-3">
        <i class="bi bi-speedometer2 fs-3"></i>
        <div>
            <h6 class="mb-1 fw-bold">Welcome, Administrator!</h6>
            <p class="mb-0 small">
                <a asp-controller="Reports" asp-action="RevenueStatistics" class="alert-link me-3"><i class="bi bi-graph-up"></i> Revenue Reports</a>
                <a asp-controller="Flights" asp-action="Create" class="alert-link"><i class="bi bi-plus-circle"></i> Add Flight</a>
            </p>
        </div>
    </div>
}

<!-- Features -->
<div class="row g-4 mb-5">
    <div class="col-md-4">
        <div class="card h-100 text-center p-4">
            <div class="mb-3" style="font-size:2.5rem;background:linear-gradient(135deg,#f5a623,#f7d26e);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;"><i class="bi bi-lightning-charge-fill"></i></div>
            <h5 class="card-title">Instant Booking</h5>
            <p class="card-text">Book flights in minutes with our streamlined, always-secure process.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center p-4">
            <div class="mb-3" style="font-size:2.5rem;background:linear-gradient(135deg,#00d4aa,#00c6ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;"><i class="bi bi-shield-check"></i></div>
            <h5 class="card-title">Secure Payments</h5>
            <p class="card-text">Industry-standard encryption protects every transaction you make.</p>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card h-100 text-center p-4">
            <div class="mb-3" style="font-size:2.5rem;background:linear-gradient(135deg,#1a73e8,#00c6ff);-webkit-background-clip:text;-webkit-text-fill-color:transparent;background-clip:text;"><i class="bi bi-ticket-detailed-fill"></i></div>
            <h5 class="card-title">E-Tickets</h5>
            <p class="card-text">Instant PDF e-tickets delivered to your email. Access anytime, anywhere.</p>
        </div>
    </div>
</div>

<!-- How It Works -->
<div class="card mb-5">
    <div class="card-header"><h5 class="mb-0"><i class="bi bi-info-circle me-2"></i>How It Works</h5></div>
    <div class="card-body p-4">
        <div class="row g-4 text-center">
            <div class="col-6 col-md-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width:64px;height:64px;background:linear-gradient(135deg,#1a73e8,#00c6ff);"><i class="bi bi-search" style="font-size:1.4rem;color:#fff;"></i></div>
                <div class="mb-1" style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(165,200,255,0.4);">Step 1</div>
                <h6 style="color:#fff;">Search Flights</h6>
                <p class="card-text small">Browse by destination and date</p>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width:64px;height:64px;background:linear-gradient(135deg,#f5a623,#f7d26e);"><i class="bi bi-hand-index-thumb" style="font-size:1.4rem;color:#1a0a00;"></i></div>
                <div class="mb-1" style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(165,200,255,0.4);">Step 2</div>
                <h6 style="color:#fff;">Select &amp; Book</h6>
                <p class="card-text small">Choose flight and seat class</p>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width:64px;height:64px;background:linear-gradient(135deg,#00d4aa,#00c6ff);"><i class="bi bi-person-vcard" style="font-size:1.4rem;color:#fff;"></i></div>
                <div class="mb-1" style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(165,200,255,0.4);">Step 3</div>
                <h6 style="color:#fff;">Passenger Details</h6>
                <p class="card-text small">Enter traveller information</p>
            </div>
            <div class="col-6 col-md-3">
                <div class="d-inline-flex align-items-center justify-content-center rounded-circle mb-3" style="width:64px;height:64px;background:linear-gradient(135deg,#a855f7,#ec4899);"><i class="bi bi-envelope-check" style="font-size:1.4rem;color:#fff;"></i></div>
                <div class="mb-1" style="font-size:0.65rem;text-transform:uppercase;letter-spacing:0.1em;color:rgba(165,200,255,0.4);">Step 4</div>
                <h6 style="color:#fff;">Get E-Ticket</h6>
                <p class="card-text small">Download your boarding pass</p>
            </div>
        </div>
    </div>
</div>

<!-- CTA -->
@if (!User.Identity.IsAuthenticated)
{
    <div class="text-center py-5 mb-4" style="background:linear-gradient(135deg,rgba(26,115,232,0.15),rgba(0,198,255,0.1));border:1px solid rgba(26,115,232,0.2);border-radius:24px;">
        <div style="font-size:3rem;margin-bottom:1rem;">✈️</div>
        <h2 style="font-family:'Space Grotesk',sans-serif;font-weight:800;color:#fff;margin-bottom:0.75rem;">Ready to Take Off?</h2>
        <p style="color:rgba(165,200,255,0.7);margin-bottom:2rem;">Join AeroNexa today and unlock seamless flight booking, e-tickets, and more.</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Auth" asp-action="Register" class="btn btn-primary btn-lg"><i class="bi bi-person-plus"></i> Create Free Account</a>
            <a asp-controller="Auth" asp-action="Login" class="btn btn-secondary btn-lg"><i class="bi bi-box-arrow-in-right"></i> Sign In</a>
        </div>
    </div>
}
else
{
    <div class="text-center py-5 mb-4 glass-panel">
        <h2 style="font-family:'Space Grotesk',sans-serif;font-weight:800;color:#fff;margin-bottom:0.5rem;">Welcome back, @User.Identity.Name! ✈️</h2>
        <p style="color:rgba(165,200,255,0.7);margin-bottom:2rem;">Ready for your next adventure?</p>
        <div class="d-flex justify-content-center gap-3 flex-wrap">
            <a asp-controller="Dashboard" asp-action="Index" class="btn btn-primary btn-lg"><i class="bi bi-speedometer2"></i> My Dashboard</a>
            <a asp-controller="Flights" asp-action="Search" class="btn btn-secondary btn-lg"><i class="bi bi-search"></i> Find Flights</a>
        </div>
    </div>
}
