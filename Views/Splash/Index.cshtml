@{
    ViewData["Title"] = "Welcome to AeroNexa";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AeroNexa | Sky is the Limit</title>
    <meta name="description" content="AeroNexa - Pakistan's premier airline ticketing platform. Search, book, and manage your flights with ease.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=Space+Grotesk:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

        html, body {
            height: 100%;
            font-family: 'Inter', sans-serif;
            overflow: hidden;
            background: #0a0f1e;
        }

        /* Stars background */
        .stars {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            z-index: 0;
            overflow: hidden;
        }

        .star {
            position: absolute;
            background: #fff;
            border-radius: 50%;
            animation: twinkle linear infinite;
        }

        @@keyframes twinkle {
            0%, 100% { opacity: 0; }
            50% { opacity: 1; }
        }

        /* Hero */
        .hero {
            position: relative;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            flex-direction: column;
            text-align: center;
            padding: 2rem;
            background:
                radial-gradient(ellipse at 20% 50%, rgba(26,115,232,0.15) 0%, transparent 60%),
                radial-gradient(ellipse at 80% 20%, rgba(0,198,255,0.1) 0%, transparent 50%),
                linear-gradient(180deg, #0a0f1e 0%, #0d1b3e 50%, #0a0f1e 100%);
            z-index: 1;
        }

        /* Animated plane silhouette */
        .plane-animation {
            position: absolute;
            top: 15%;
            font-size: 2.5rem;
            color: rgba(26,115,232,0.3);
            animation: flyAcross 12s linear infinite;
            z-index: 0;
        }

        @@keyframes flyAcross {
            0% { left: -5%; opacity: 0; transform: translateY(0) rotate(5deg); }
            5% { opacity: 1; }
            95% { opacity: 1; }
            100% { left: 110%; opacity: 0; transform: translateY(-20px) rotate(5deg); }
        }

        /* Logo */
        .logo {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 900;
            font-size: clamp(3.5rem, 10vw, 6.5rem);
            letter-spacing: -2px;
            background: linear-gradient(135deg, #fff 0%, #a5c8ff 40%, #00c6ff 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
            animation: logoReveal 1s cubic-bezier(0.34, 1.56, 0.64, 1);
            position: relative;
            z-index: 2;
        }

        @@keyframes logoReveal {
            from { opacity: 0; transform: translateY(-40px) scale(0.9); }
            to   { opacity: 1; transform: translateY(0) scale(1); }
        }

        .tagline {
            font-size: clamp(0.9rem, 2.5vw, 1.25rem);
            font-weight: 300;
            color: rgba(165, 200, 255, 0.8);
            letter-spacing: 0.3em;
            text-transform: uppercase;
            margin-top: 0.5rem;
            margin-bottom: 2.5rem;
            animation: fadeIn 1.5s ease forwards;
            animation-delay: 0.3s;
            opacity: 0;
            position: relative;
            z-index: 2;
        }

        @@keyframes fadeIn {
            from { opacity: 0; transform: translateY(10px); }
            to   { opacity: 1; transform: translateY(0); }
        }

        /* Stats row */
        .stats-row {
            display: flex;
            gap: 2.5rem;
            justify-content: center;
            flex-wrap: wrap;
            margin-bottom: 2.5rem;
            animation: fadeIn 1s ease forwards;
            animation-delay: 0.6s;
            opacity: 0;
            position: relative;
            z-index: 2;
        }

        .stat-item {
            text-align: center;
        }

        .stat-number {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 1.75rem;
            font-weight: 800;
            background: linear-gradient(90deg, #1a73e8, #00c6ff);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            background-clip: text;
        }

        .stat-label {
            font-size: 0.7rem;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            color: rgba(165,200,255,0.5);
            margin-top: 2px;
        }

        /* Buttons */
        .btn-row {
            display: flex;
            gap: 1rem;
            flex-wrap: wrap;
            justify-content: center;
            animation: fadeIn 1s ease forwards;
            animation-delay: 0.8s;
            opacity: 0;
            position: relative;
            z-index: 2;
        }

        .btn-primary-hero {
            background: linear-gradient(135deg, #1a73e8, #00c6ff);
            color: #fff;
            border: none;
            padding: 1rem 2.5rem;
            border-radius: 100px;
            font-size: 1rem;
            font-weight: 700;
            cursor: pointer;
            box-shadow: 0 8px 32px rgba(26,115,232,0.5);
            transition: all 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
            display: flex;
            align-items: center;
            gap: 0.5rem;
            text-decoration: none;
        }

        .btn-primary-hero:hover {
            transform: translateY(-4px) scale(1.03);
            box-shadow: 0 16px 48px rgba(26,115,232,0.65);
            color: #fff;
        }

        .btn-ghost-hero {
            background: rgba(255,255,255,0.08);
            color: rgba(255,255,255,0.85);
            border: 1px solid rgba(255,255,255,0.2);
            padding: 1rem 2.5rem;
            border-radius: 100px;
            font-size: 1rem;
            font-weight: 600;
            cursor: pointer;
            transition: all 0.3s ease;
            backdrop-filter: blur(8px);
        }

        .btn-ghost-hero:hover {
            background: rgba(255,255,255,0.15);
            border-color: rgba(255,255,255,0.4);
            transform: translateY(-2px);
            color: #fff;
        }

        /* Credits glass card */
        .credits-card {
            margin-top: 3rem;
            background: rgba(255,255,255,0.05);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(255,255,255,0.1);
            border-radius: 20px;
            padding: 1.5rem 2rem;
            max-width: 600px;
            width: 100%;
            animation: fadeIn 1s ease forwards;
            animation-delay: 1.1s;
            opacity: 0;
            position: relative;
            z-index: 2;
        }

        .credits-label {
            font-size: 0.65rem;
            text-transform: uppercase;
            letter-spacing: 0.2em;
            color: rgba(165,200,255,0.4);
            margin-bottom: 0.75rem;
        }

        .credits-developers {
            font-size: 0.9rem;
            color: rgba(226,232,240,0.85);
            font-weight: 500;
            margin-bottom: 0.75rem;
        }

        .credits-developers strong {
            color: #a5c8ff;
        }

        .divider { border: none; border-top: 1px solid rgba(255,255,255,0.1); margin: 0.75rem 0; }

        .credits-guide {
            font-size: 0.8rem;
            color: rgba(165,200,255,0.6);
        }

        /* Page transition overlay */
        .page-overlay {
            position: fixed;
            top: 0; left: 0;
            width: 100%; height: 100%;
            background: #0a0f1e;
            z-index: 9999;
            opacity: 0;
            pointer-events: none;
            transition: opacity 0.6s ease;
        }

        .page-overlay.active { opacity: 1; pointer-events: all; }

        /* Scroll indicator */
        .scroll-hint {
            position: absolute;
            bottom: 2rem;
            left: 50%;
            transform: translateX(-50%);
            color: rgba(165,200,255,0.3);
            font-size: 0.75rem;
            letter-spacing: 0.1em;
            text-transform: uppercase;
            animation: bounce 2s ease-in-out infinite;
            z-index: 2;
        }

        @@keyframes bounce {
            0%, 100% { transform: translateX(-50%) translateY(0); }
            50% { transform: translateX(-50%) translateY(-8px); }
        }
    </style>
</head>
<body>

    <!-- Stars -->
    <div class="stars" id="stars"></div>

    <!-- Flying plane -->
    <div class="plane-animation"><i class="bi bi-airplane-fill"></i></div>

    <!-- Page transition overlay -->
    <div class="page-overlay" id="overlay"></div>

    <div class="hero">
        <div class="logo">AeroNexa</div>
        <p class="tagline">Elevating Your Journey</p>

        <div class="stats-row">
            <div class="stat-item">
                <div class="stat-number">50+</div>
                <div class="stat-label">Routes</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">13</div>
                <div class="stat-label">Airports</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">3</div>
                <div class="stat-label">Seat Classes</div>
            </div>
            <div class="stat-item">
                <div class="stat-number">24/7</div>
                <div class="stat-label">Support</div>
            </div>
        </div>

        <div class="btn-row">
            <button id="yesFly" class="btn-primary-hero">
                <i class="bi bi-airplane-fill"></i>
                Board Now
            </button>
            <button id="learnMore" class="btn-ghost-hero">
                Learn More
            </button>
        </div>

        <div class="credits-card">
            <div class="credits-label">Software Construction & Development</div>
            <div class="credits-developers">
                <strong>Developers:</strong> Mustafa Muhammad · Khushi Kandhani · Peyoush Gurwani · Subhash Makhija
            </div>
            <hr class="divider">
            <div class="credits-guide">
                <i class="bi bi-mortarboard-fill me-1"></i>
                <strong>Guided by:</strong> Sir Mustafa Hasan Ali &amp; Sir Salar Sabir Faiz &nbsp;·&nbsp;
                <strong>Evaluation:</strong> Miss Tabinda
            </div>
        </div>
    </div>

    <script>
        // Generate stars
        const starsContainer = document.getElementById('stars');
        for (let i = 0; i < 150; i++) {
            const star = document.createElement('div');
            star.classList.add('star');
            const size = Math.random() * 2.5 + 0.5;
            star.style.cssText = `
                width: ${size}px; height: ${size}px;
                top: ${Math.random() * 100}%;
                left: ${Math.random() * 100}%;
                animation-duration: ${Math.random() * 4 + 2}s;
                animation-delay: ${Math.random() * 4}s;
            `;
            starsContainer.appendChild(star);
        }

        // Board now button
        document.getElementById('yesFly').addEventListener('click', function () {
            const overlay = document.getElementById('overlay');
            overlay.classList.add('active');
            setTimeout(() => { window.location.href = '/Home/Index'; }, 600);
        });

        // Learn more - smooth scroll to credits or open home in same
        document.getElementById('learnMore').addEventListener('click', function () {
            const card = document.querySelector('.credits-card');
            card.scrollIntoView({ behavior: 'smooth' });
            card.style.borderColor = 'rgba(26,115,232,0.4)';
            card.style.boxShadow = '0 8px 48px rgba(26,115,232,0.2)';
            setTimeout(() => {
                card.style.borderColor = 'rgba(255,255,255,0.1)';
                card.style.boxShadow = 'none';
            }, 2000);
        });
    </script>
</body>
</html>
